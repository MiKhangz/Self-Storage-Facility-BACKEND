<mxfile host="app.diagrams.net" type="device"><diagram name="Rental lifecycle swimlane" id="rental-lifecycle"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5310" pageHeight="950" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="StorEase — Rental lifecycle (as built today)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="-110" width="700" height="34" as="geometry"/></mxCell><mxCell id="lg0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="-106" width="60" height="26" as="geometry"/></mxCell><mxCell id="lgt0" value="Person's action" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790" y="-106" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="930" y="-106" width="60" height="26" as="geometry"/></mxCell><mxCell id="lgt1" value="Automatic (system)" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1000" y="-106" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg2" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1140" y="-106" width="60" height="26" as="geometry"/></mxCell><mxCell id="lgt2" value="Not built yet" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1210" y="-106" width="140" height="26" as="geometry"/></mxCell><mxCell id="lg3" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1350" y="-106" width="40" height="30" as="geometry"/></mxCell><mxCell id="lgt3" value="Decision" style="text;html=1;fontSize=11;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1420" y="-106" width="140" height="26" as="geometry"/></mxCell><mxCell id="ph0" value="1. Register &amp; reserve" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="-50" width="1000" height="40" as="geometry"/></mxCell><mxCell id="ph1" value="2. Deposit &amp; unit assignment" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1070" y="-50" width="600" height="40" as="geometry"/></mxCell><mxCell id="ph2" value="3. Contract &amp; handover" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1670" y="-50" width="1200" height="40" as="geometry"/></mxCell><mxCell id="ph3" value="4. Monthly rent &amp; overdue" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2870" y="-50" width="800" height="40" as="geometry"/></mxCell><mxCell id="ph4" value="5. Renewal" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="3670" y="-50" width="400" height="40" as="geometry"/></mxCell><mxCell id="ph5" value="6. Move-out &amp; deposit settlement" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="4070" y="-50" width="1200" height="40" as="geometry"/></mxCell><mxCell id="lane_C" value="Customer" style="swimlane;horizontal=0;html=1;startSize=60;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="5270" height="250" as="geometry"/></mxCell><mxCell id="lane_S" value="Staff (Facility Staff / Manager)" style="swimlane;horizontal=0;html=1;startSize=60;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="250" width="5270" height="250" as="geometry"/></mxCell><mxCell id="lane_A" value="Admin (Business Ops / System Admin)" style="swimlane;horizontal=0;html=1;startSize=60;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="500" width="5270" height="250" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="lane_C"><mxGeometry x="153.0" y="108.0" width="34" height="34" as="geometry"/></mxCell><mxCell id="c_reg" value="Register account&#xa;(Active at once in Development)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="284.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_quote" value="Choose facility, size,&#xa;move-in date &amp; period&#xa;→ see quote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="484.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_reserve" value="Reserve unit&#xa;(accept rental agreement)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="684.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_res" value="Create reservation (Pending)&#xa;+ deposit invoice DEP…" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="884.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_dep" value="Pay deposit online&#xa;(simulated gateway)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="1084.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_dep" value="Mark deposit invoice Paid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="1284.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_assign" value="Assign a unit&#xa;→ reservation Confirmed,&#xa;unit Reserved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="1484.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_draft" value="Draft contract&#xa;(rent day 1–28; rent from&#xa;active pricing policy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="1684.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_sign" value="Sign contract&#xa;(My Storage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="1884.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_hand" value="Handover checklist: verify ID&#xa;&amp; payment, inspect unit,&#xa;record lock &amp; card no." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="2084.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_ok" value="Deposit paid&#xa;&amp; contract&#xa;signed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="lane_S"><mxGeometry x="2315.0" y="80.0" width="110" height="90" as="geometry"/></mxCell><mxCell id="a_active" value="Contract Active, unit Occupied,&#xa;one-time access code issued" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="2484.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_code" value="Receive access code;&#xa;use unit (gate entries logged)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="2684.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_inv" value="Every month: issue rent&#xa;invoice 7 days before due;&#xa;email reminder 3 days before" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="2884.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_ontime" value="Pay by&#xa;due date?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=10;" vertex="1" parent="lane_C"><mxGeometry x="3115.0" y="80.0" width="110" height="90" as="geometry"/></mxCell><mxCell id="c_pay" value="Pay rent online" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="3284.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_cash" value="Record cash payment&#xa;at the counter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="3284.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_overdue" value="Overdue: late fee per week&#xa;after grace days; lock-out at&#xa;suspend limit (contract&#xa;Suspended, access codes off)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="3084.0" y="83.0" width="172" height="84" as="geometry"/></mxCell><mxCell id="a_restore" value="Paid in full → overdue case&#xa;resolved, access restored" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="3484.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_renew" value="Request renewal&#xa;(+1 / 3 / 6 / 12 months)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="3684.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_renew" value="Approve renewal&#xa;(NOT BUILT YET — request&#xa;stays Pending)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontColor=#777777;dashed=1;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="3884.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_moveout" value="Request move-out&#xa;(date ≥ notice days,&#xa;refund account)&#xa;→ contract PendingMoveOut" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_C"><mxGeometry x="4084.0" y="83.0" width="172" height="84" as="geometry"/></mxCell><mxCell id="s_approve" value="Approve move-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="4284.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="s_inspect" value="Return inspection&#xa;(condition, cleaning /&#xa;repair charges)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_S"><mxGeometry x="4484.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_settle" value="Settle deposit (Business Ops)&#xa;refund = deposit − charges&#xa;− unpaid invoices" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="lane_A"><mxGeometry x="4684.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="a_close" value="Contract Closed, access codes&#xa;off, unit Available&#xa;(Maintenance if major damage)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#b07d00;dashed=1;dashPattern=6 3;fontSize=11;fontStyle=2;" vertex="1" parent="lane_A"><mxGeometry x="4884.0" y="90.0" width="172" height="70" as="geometry"/></mxCell><mxCell id="c_end" value="" style="ellipse;html=1;shape=doubleEllipse;fillColor=#333333;strokeColor=#333333;" vertex="1" parent="lane_C"><mxGeometry x="5151.0" y="106.0" width="38" height="38" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="start" target="c_reg"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_reg" target="c_quote"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_quote" target="c_reserve"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c_reserve" target="a_res"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4"